# OpenAI API Configuration
# Get your API key from https://platform.openai.com
# If left blank, Voxora runs in smart offline demo mode with mock brain & Edge-TTS!
OPENAI_API_KEY=

# LLM Model for Agent Brain
OPENAI_MODEL=gpt-4o-mini

# Whisper Model for Speech-to-Text
WHISPER_MODEL=whisper-1

# Text-to-Speech Engine: "edge-tts" (Free neural voices, no API key) or "openai"
TTS_PROVIDER=edge-tts

# Edge TTS Voices: en-US-AriaNeural, en-US-GuyNeural, en-US-JennyNeural, en-GB-SoniaNeural
EDGE_TTS_VOICE=en-US-AriaNeural

# OpenAI TTS Voices: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=alloy

# Server Port
PORT=8000
