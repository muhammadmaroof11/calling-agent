# ==========================================
# Voxora Calling Agent - Free AI Stack Configuration
# ==========================================

# 1. Groq Cloud (Free Tier - https://console.groq.com)
# Provides ultra-fast Whisper STT (whisper-large-v3-turbo)
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo
GROQ_MODEL=qwen/qwen3.8-27b

# 2. Google Gemini (Free Tier - https://aistudio.google.com)
# Provides conversational reasoning LLM (gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Active Providers:
STT_PROVIDER=groq
LLM_PROVIDER=gemini

# 3. Text-to-Speech (TTS):
# Options: "edge-tts" (100% free neural voices) or "fish-audio"
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE=en-US-AriaNeural

# Optional: Fish Audio (Free starter credits at https://fish.audio)
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=

# Server Port
PORT=8000
